# =============================================================================
# MongoDB Connection Collector — Configuration
# =============================================================================
#
# This file is the single source of the collector's configurable values.
# Wire it into the systemd service via EnvironmentFile= so the script and its
# schedule share one source of truth.
#
# Every value has a documented default in the script, so a missing or blank
# entry here is non-fatal. Changes apply on the next collection cycle (~60s).

# --- MongoDB port to inspect ---
# The local MongoDB port whose established sockets are counted by client IP.
# MONGO_PORT=27017

# --- node_exporter textfile-collector directory ---
# The directory the collector writes its .prom into. With a standard PMM install
# use the agent's managed low-resolution dir:
#   high-resolution   (~5s scrape)
#   medium-resolution (~10s scrape)
#   low-resolution    (~60s scrape)  <-- use this one
TEXTFILE_COLLECTOR_DIR=/usr/local/percona/pmm/collectors/textfile-collector/low-resolution

# --- Published .prom file ---
# Full path of the atomically published metrics file. Defaults to
# $TEXTFILE_COLLECTOR_DIR/mongodb_client_connections.prom
# OUT_FILE=/usr/local/percona/pmm/collectors/textfile-collector/low-resolution/mongodb_client_connections.prom

# --- Node Attribution Resolver cache (READ ONLY by the collector) ---
# The cache produced by resolve_client_nodes.py that the collector reads to
# stamp client_node / client_instance_id labels. Placed in the textfile-collector
# PARENT dir so it is never scraped as a *.prom file.
CLIENT_NODE_CACHE=/usr/local/percona/pmm/collectors/textfile-collector/.client_node_cache.tsv

# --- Loopback / health-check IPs to exclude ---
# Space-separated peer addresses dropped before aggregation.
EXCLUDE_IPS=127.0.0.1 ::1

# --- This host's IP for server_name resolution ---
# Leave unset to auto-detect the host's primary IP (hostname -I / ip route).
# SERVER_IP=10.0.1.5
